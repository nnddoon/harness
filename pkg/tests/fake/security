#!/bin/sh
# 假 macOS security（T-018）：只认 find-generic-password / find-internet-password -s <服务名>。
#   FAKE_SECURITY_LOG    每次调用追加一行参数（空格分隔）
#   FAKE_SECURITY_GH     find-generic-password -s gh:github.com 的退出码（默认见 FAKE_SECURITY_RC）
#   FAKE_SECURITY_NET    find-internet-password -s github.com 的退出码（同上）
#   FAKE_SECURITY_ITEMS  存在的项，用 | 分隔：generic:<服务名> / internet:<服务名>（服务名可含 : 和空格）
#   FAKE_SECURITY_RC     不存在时的退出码（默认 44；设成别的值模拟钥匙串出错）
#   FAKE_SECURITY_SLEEP  每次调用先睡几秒（模拟卡住）
# 命中时像真 security 一样打印属性（含 FAKE-KEYCHAIN-ATTR 标记）；带 -w / -g 时还会「泄露」FAKE-SECRET-ghp_leak，
# 测试据此断言调用方既没带读取内容的参数，也没把输出回显出去。
[ -n "${FAKE_SECURITY_LOG:-}" ] && printf '%s\n' "$*" >> "$FAKE_SECURITY_LOG"
[ -n "${FAKE_SECURITY_SLEEP:-}" ] && sleep "$FAKE_SECURITY_SLEEP"
cmd="${1:-}"; svc=""; reads=0; prev=""
for a in "$@"; do
  [ "$prev" = "-s" ] && svc="$a"
  case "$a" in -w|-g) reads=1;; esac
  prev="$a"
done
absent="${FAKE_SECURITY_RC:-44}"
case "$cmd" in
  find-generic-password) kind=generic ;;
  find-internet-password) kind=internet ;;
  *) kind=other ;;
esac
rc="$absent"
case "$kind:$svc" in
  generic:gh:github.com) rc="${FAKE_SECURITY_GH:-$absent}" ;;
  internet:github.com) rc="${FAKE_SECURITY_NET:-$absent}" ;;
esac
if [ -n "${FAKE_SECURITY_ITEMS:-}" ]; then
  old_ifs="$IFS"; IFS='|'
  for it in $FAKE_SECURITY_ITEMS; do [ "$it" = "$kind:$svc" ] && rc=0; done
  IFS="$old_ifs"
fi
if [ "$rc" -ne 0 ]; then
  echo "security: SecKeychainSearchCopyNext: The specified item could not be found in the keychain." >&2
  exit "$rc"
fi
echo "keychain: \"/Users/x/Library/Keychains/login.keychain-db\""
echo "attributes: FAKE-KEYCHAIN-ATTR svce=\"$svc\""
[ "$reads" -eq 1 ] && echo "password: \"FAKE-SECRET-ghp_leak\""
exit 0
